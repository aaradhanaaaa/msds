# ============================================================================
# MSDS Substation Monitor — backend configuration
#
# Copy this file to ".env" and fill in the REAL site values before running
# against an actual ABB RTU560. Every value below is an EXAMPLE placeholder,
# not a real SAIL IP address or register mapping.
#
#   cp .env.example .env
# ============================================================================

# ---------------------------------------------------------------------------
# HTTP / WebSocket server
# ---------------------------------------------------------------------------
# Port the REST API and static frontend are served on.
HTTP_PORT=4000

# Port the WebSocket server (real-time telemetry push) listens on.
WS_PORT=4001

# ---------------------------------------------------------------------------
# Modbus TCP client (this app acts as the CLIENT/MASTER; the ABB RTU560 is
# the Modbus TCP SERVER/SLAVE it connects to)
# ---------------------------------------------------------------------------
# EXAMPLE ONLY — replace with the real RTU560 IP address on your OT network.
MODBUS_HOST=192.0.2.10

# Standard Modbus TCP port. Change only if the RTU560 is configured to
# listen on a non-standard port.
MODBUS_PORT=502

# Default Modbus unit/slave ID to use when a substation's entry in
# config/registerMap.json does not specify its own unitId.
MODBUS_DEFAULT_UNIT_ID=1

# How long (ms) to wait for a single Modbus request/response before it is
# treated as a timeout. Keep this well below POLL_INTERVAL_MS.
MODBUS_TIMEOUT_MS=2000

# How long (ms) to wait before retrying the TCP connection after it drops
# or fails to establish. Doubles on each consecutive failure up to
# MODBUS_RECONNECT_MAX_MS (simple capped exponential backoff), so the
# service keeps trying quietly in the background without blocking startup
# or crashing when the RTU560 is unreachable.
MODBUS_RECONNECT_MIN_MS=2000
MODBUS_RECONNECT_MAX_MS=30000

# Word/byte order used when decoding a 32-bit IEEE-754 float from two
# consecutive 16-bit input registers. This varies by device/configuration —
# check the RTU560's Modbus point-mapping export to confirm.
#   BADC = big-endian bytes, swapped word order (common default assumed here)
#   ABCD = big-endian, no swap
#   CDAB = little-endian bytes, swapped word order
#   DCBA = little-endian, no swap
MODBUS_FLOAT_WORD_ORDER=BADC

# ---------------------------------------------------------------------------
# Polling / telemetry
# ---------------------------------------------------------------------------
# How often (ms) the service polls every configured register, for every
# substation, in sequence (Modbus TCP is a single-outstanding-request
# protocol per connection, so all reads in a cycle happen one after another).
POLL_INTERVAL_MS=4000

# How many recent samples to keep in the in-memory rolling history per
# substation/parameter (used for the dashboard's sparkline graphs).
HISTORY_LENGTH=12

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Path to the SQLite database file (created automatically on first run).
DB_PATH=./data/telemetry.db

# ---------------------------------------------------------------------------
# Register map
# ---------------------------------------------------------------------------
# Path to the JSON file describing which substation/parameter maps to which
# Modbus register, unit ID, and scaling factor. See
# config/registerMap.example.json for the EXAMPLE structure and values —
# copy it to config/registerMap.json and replace with the real site mapping.
REGISTER_MAP_PATH=./config/registerMap.json
